# 自研内核与可选的大模型裁判。不要把真实密钥提交到仓库。
EVAL_API_KEY=
EVAL_BASE_URL=https://api.example.com/v1
EVAL_JUDGE_MODEL=kimi-2.5
EVAL_DEFAULT_SKILL_DIR=
EVAL_DATA_DIR=logs
EVAL_HTTP_ADDR=:8080

# 外部 CLI。认证沿用各自的环境变量或本机登录，不写在这里的值不会被程序读取进 trace。
CODEX_BIN=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL=never
CLAUDE_BIN=
CLAUDE_PERMISSION_MODE=bypassPermissions

# Codex 使用 OPENAI_API_KEY 或已有登录。
# Claude Code 使用 ANTHROPIC_API_KEY 或已有登录。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
